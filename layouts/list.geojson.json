{{- /* ── the days and their located photos ─────────────────────────────── */ -}}
{{- $days := slice -}}
{{- $pins := slice -}}
{{- range .Pages -}}
  {{- $page := . -}}
  {{- $cover := partial "cover.html" $page -}}
  {{- $photos := slice -}}
  {{- /* The album leaves the opener out, so the tiles are numbered without it.
         Counting over every photo here would point each pin at its neighbour. */ -}}
  {{- $n := 0 -}}
  {{- range $photo := partial "photos.html" $page -}}
    {{- $tile := -1 -}}
    {{- if or (not $cover) (ne $photo.url $cover.url) -}}
      {{- $tile = $n -}}
      {{- $n = add $n 1 -}}
    {{- end -}}
    {{- if and $photo.lat $photo.lon -}}
      {{- $time := "" -}}
      {{- if gt (len $photo.date) 15 }}{{ $time = substr $photo.date 11 5 }}{{ end -}}
      {{- $photos = $photos | append (dict
          "lat" $photo.lat
          "long" $photo.lon
          "url" $photo.url
          "w" $photo.w
          "h" $photo.h
          "thumb" $photo.pin
          "thumbwidth" 128
          "large" $photo.pinlarge
          "time" $time
          "caption" $photo.caption
          "index" $tile) -}}
      {{- $pins = $pins | append (dict "lat" $photo.lat "long" $photo.lon) -}}
    {{- end -}}
  {{- end -}}
  {{- with $photos -}}
    {{- $days = $days | append (dict
        "title" $page.Title
        "url" $page.RelPermalink
        "photos" .) -}}
  {{- end -}}
{{- end -}}

{{- /* ── which countries, and which parts of them ─────────────────────────
       Points are grouped into tenth-of-a-degree cells first, or every photo
       would compute the same answer again. The countries themselves are worked
       out in their own partial: the result hangs on the coordinates alone, so
       both languages of a journey share one computation. */ -}}
{{- $cells := slice -}}
{{- $seen := slice -}}
{{- range $pins -}}
  {{- $key := printf "%.1f/%.1f" .lat .long -}}
  {{- if not (in $seen $key) -}}
    {{- $seen = $seen | append $key -}}
    {{- $cells = $cells | append . -}}
  {{- end -}}
{{- end -}}
{{- $maps := partialCached "countries.html" (dict "cells" $cells) .Path -}}

{{- dict "maps" $maps "days" $days | jsonify -}}
