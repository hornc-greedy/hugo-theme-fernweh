{{- /* ── the days and their located photos ─────────────────────────────── */ -}}
{{- $days := slice -}}
{{- $pins := slice -}}
{{- range .Pages.ByDate -}}
  {{- $page := . -}}
  {{- $cover := partial "cover.html" $page -}}
  {{- $photos := slice -}}
  {{- /* The album leaves the opener out, so the tiles are numbered without it.
         Counting over every photo here would point each pin at its neighbour. */ -}}
  {{- $n := 0 -}}
  {{- range $photo := partial "photos.html" $page -}}
    {{- $tile := -1 -}}
    {{- if or (not $cover) (ne $photo.url $cover.url) -}}
      {{- $tile = $n -}}
      {{- $n = add $n 1 -}}
    {{- end -}}
    {{- if and $photo.lat $photo.lon -}}
      {{- $time := "" -}}
      {{- if gt (len $photo.date) 15 }}{{ $time = substr $photo.date 11 5 }}{{ end -}}
      {{- $photos = $photos | append (dict
          "lat" $photo.lat
          "long" $photo.lon
          "url" $photo.url
          "w" $photo.w
          "h" $photo.h
          "color" $photo.color
          "thumb" $photo.pin
          "thumbwidth" 128
          "large" $photo.pinlarge
          "cuts" (printf "%s %dw, %s %dw, %s %dw"
              $photo.small $photo.sw $photo.medium $photo.mw $photo.url (int $photo.w))
          "time" $time
          "caption" $photo.caption
          "index" $tile) -}}
      {{- $pins = $pins | append (dict "lat" $photo.lat "long" $photo.lon) -}}
    {{- end -}}
  {{- end -}}
  {{- with $photos -}}
    {{- $days = $days | append (dict
        "title" $page.Title
        "url" $page.RelPermalink
        "photos" .) -}}
  {{- end -}}
{{- end -}}

{{- /* ── which maps, and which photo stands on which ──────────────────────
       Points are grouped into tenth-of-a-degree cells first, or every photo
       would compute the same answer again. The maps themselves are worked out
       in their own partial: the result hangs on the coordinates alone, so both
       languages of a journey share one computation. */ -}}
{{- $cells := dict -}}
{{- range $pins -}}
  {{- $key := printf "%.1f/%.1f" .lat .long -}}
  {{- if not (isset $cells $key) -}}
    {{- $cells = merge $cells (dict $key (dict "key" $key "lat" .lat "long" .long)) -}}
  {{- end -}}
{{- end -}}
{{- $cellList := slice -}}
{{- range $cells -}}{{- $cellList = $cellList | append . -}}{{- end -}}
{{- $maps := partialCached "countries.html" (dict "cells" $cellList) .Path -}}

{{- $mapIndexOf := dict -}}
{{- range $i, $map := $maps -}}
  {{- range $map.keys -}}{{- $mapIndexOf = merge $mapIndexOf (dict . $i) -}}{{- end -}}
{{- end -}}
{{- $placedDays := slice -}}
{{- range $day := $days -}}
  {{- $photos := slice -}}
  {{- range $day.photos -}}
    {{- $key := printf "%.1f/%.1f" .lat .long -}}
    {{- if isset $mapIndexOf $key -}}
      {{- $photos = $photos | append (merge . (dict "mapIndex" (index $mapIndexOf $key))) -}}
    {{- end -}}
  {{- end -}}
  {{- with $photos -}}
    {{- $placedDays = $placedDays | append (merge $day (dict "photos" .)) -}}
  {{- end -}}
{{- end -}}
{{- $geometries := slice -}}
{{- range $maps -}}{{- $geometries = $geometries | append (dict "geometry" .geometry) -}}{{- end -}}

{{- dict "maps" $geometries "days" $placedDays | jsonify -}}
