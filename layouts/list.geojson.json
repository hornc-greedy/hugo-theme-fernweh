{{- /* ── the days and their located photos ─────────────────────────────── */ -}}
{{- $days := slice -}}
{{- $pins := slice -}}
{{- range .Pages.ByDate -}}
  {{- $page := . -}}
  {{- $cover := partial "cover.html" $page -}}
  {{- $photos := slice -}}
  {{- /* The album leaves the opener out, so the tiles are numbered without it.
         Counting over every photo here would point each pin at its neighbour. */ -}}
  {{- $n := 0 -}}
  {{- range $photo := partialCached "photos.html" $page $page.Path -}}
    {{- $tile := -1 -}}
    {{- if ne $photo.url $cover.url -}}
      {{- $tile = $n -}}
      {{- $n = add $n 1 -}}
    {{- end -}}
    {{- if isset $photo "lat" -}}
      {{- $time := "" -}}
      {{- if gt (len $photo.date) 15 }}{{ $time = substr $photo.date 11 5 }}{{ end -}}
      {{- $photos = $photos | append (dict
          "lat" $photo.lat
          "long" $photo.lon
          "url" $photo.url
          "w" $photo.w
          "h" $photo.h
          "color" $photo.color
          "thumb" $photo.pin
          "thumbwidth" $photo.pw
          "large" $photo.pinlarge
          "cuts" $photo.srcset
          "time" $time
          "caption" $photo.caption
          "index" $tile) -}}
      {{- $pins = $pins | append (dict "lat" $photo.lat "long" $photo.lon "boundary" ($photo.boundary | default "")) -}}
    {{- end -}}
  {{- end -}}
  {{- with $photos -}}
    {{- $days = $days | append (dict
        "title" $page.Title
        "url" $page.RelPermalink
        "photos" .) -}}
  {{- end -}}
{{- end -}}

{{- /* ── which maps, and which photo stands on which ──────────────────────
       Points are grouped into tenth-of-a-degree cells first, or every photo
       would compute the same answer again. The maps themselves are worked out
       in their own partial, once per journey and language. */ -}}
{{- $cells := dict -}}
{{- range $pins -}}
  {{- $key := printf "%.1f/%.1f" .lat .long -}}
  {{- $cell := index $cells $key | default (dict "key" $key "lat" .lat "long" .long "points" slice) -}}
  {{- $cells = merge $cells (dict $key (merge $cell (dict
      "points" ($cell.points | append (dict "lat" .lat "long" .long "boundary" .boundary))))) -}}
{{- end -}}
{{- $maps := partialCached "countries.html" (dict "cells" $cells) .Path -}}

{{- $mapIndexOf := dict -}}
{{- range $i, $map := $maps -}}
  {{- range $map.keys -}}{{- $mapIndexOf = merge $mapIndexOf (dict . $i) -}}{{- end -}}
{{- end -}}
{{- $placedDays := slice -}}
{{- range $day := $days -}}
  {{- $photos := slice -}}
  {{- range $day.photos -}}
    {{- $key := printf "%.1f/%.1f" .lat .long -}}
    {{- if isset $mapIndexOf $key -}}
      {{- $photos = $photos | append (merge . (dict "mapIndex" (index $mapIndexOf $key))) -}}
    {{- end -}}
  {{- end -}}
  {{- with $photos -}}
    {{- $placedDays = $placedDays | append (merge $day (dict "photos" .)) -}}
  {{- end -}}
{{- end -}}
{{- $geometries := slice -}}
{{- range $maps -}}
  {{- $shape := dict "geometry" .geometry -}}
  {{- with .locator -}}{{- $shape = merge $shape (dict "locator" .) -}}{{- end -}}
  {{- $geometries = $geometries | append $shape -}}
{{- end -}}

{{- dict "maps" $geometries "days" $placedDays | jsonify -}}
